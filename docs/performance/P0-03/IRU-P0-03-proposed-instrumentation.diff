+# Proposal only: opt-in numeric accounting in existing llm_usage metadata.
+def performance_context(context, payload):
+    if os.getenv("IRU_PERFORMANCE_BASELINE") != "1":
+        return context
+    try:
+        encoded = json.dumps(payload, ensure_ascii=False, separators=(",", ":"))
+        fields = {
+            "serialized_input_bytes": len(encoded.encode("utf-8")),
+            "serialized_input_chars": len(encoded),
+            "message_count": len(payload.get("messages") or []),
+            "schema_count": len(payload.get("tools") or []),
+            "schemas_bytes": len(json.dumps(payload["tools"], ensure_ascii=False, separators=(",", ":")).encode("utf-8")) if "tools" in payload else 0,
+            "http_attempt_count": 0,
+            "llm_http_elapsed_ms": 0.0,
+        }
+        for role in ("system", "user", "assistant", "tool"):
+            fields[role + "_content_bytes"] = sum(
+                len(row["content"].encode("utf-8"))
+                for row in payload.get("messages", [])
+                if row.get("role") == role and isinstance(row.get("content"), str)
+            )
+        return {**(context or {}), "_performance": {"started": time.perf_counter(), "fields": fields}}
+    except Exception:
+        return context
+
+
+async def performance_post(client, context, *args, **kwargs):
+    perf = (context or {}).get("_performance")
+    if perf is None:
+        return await client.post(*args, **kwargs)
+    started = time.perf_counter()
+    try:
+        return await client.post(*args, **kwargs)
+    finally:
+        try:
+            fields = perf["fields"]
+            fields["http_attempt_count"] += 1
+            fields["llm_http_elapsed_ms"] += (time.perf_counter() - started) * 1000
+        except Exception:
+            pass
+
+
+def performance_usage(context, data):
+    try:
+        perf = (context or {}).get("_performance")
+        if perf is None:
+            return
+        usage = data.get("usage") if isinstance(data, dict) else None
+        valid = isinstance(usage, dict)
+        for key in ("prompt_tokens", "completion_tokens", "prompt_cache_hit_tokens", "prompt_cache_miss_tokens"):
+            perf["fields"][key + "_known"] = int(valid and type(usage.get(key)) is int)
+    except Exception:
+        pass
+
+
+def performance_metadata(context, metadata):
+    try:
+        perf = context.get("_performance")
+        if perf is None:
+            return metadata
+        fields = dict(perf["fields"])
+        fields["llm_request_elapsed_ms"] = (time.perf_counter() - perf["started"]) * 1000
+        # Content, credentials, filenames and raw provider errors never enter this object.
+        return {**(metadata if isinstance(metadata, dict) else {}), "performance": fields}
+    except Exception:
+        return metadata
 
 
